# ---- Server ----
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/foodvaani
JWT_SECRET=change-this-to-a-long-random-string
# Public base URL of this API, used to build audio links
PUBLIC_URL=http://localhost:5000

# ---- OTP ----
# dev  -> OTP is printed in the server console and returned to the client (for demos)
# off  -> never returned to the client; plug in your SMS provider in src/services/sms.js
OTP_MODE=dev

# ---- Gnani (keep these on the server only) ----
GNANI_API_KEY=your-gnani-api-key
GNANI_BASE_URL=https://api.vachana.ai

# Prisma (speech to text)
PRISMA_MODEL=prisma-v3.0
# indic-auto works with prisma-v3.0. For prisma-v2.5 use a fixed code like hi-IN
PRISMA_DEFAULT_LANGUAGE=indic-auto

# Timbre (text to speech)
TIMBRE_MODEL=timbre-v2.5
TIMBRE_VOICE_HI=Nalini
TIMBRE_VOICE_EN=Kaveri
TIMBRE_VOICE_DEFAULT=Nalini

# ---- Evon / LLM extraction (optional) ----
# Any OpenAI-compatible /chat/completions endpoint. Put your Gnani Evon endpoint here
# if you have access. Leave EXTRACTOR_API_URL empty to use the built-in rule-based extractor.
EXTRACTOR_API_URL=
EXTRACTOR_API_KEY=
EXTRACTOR_MODEL=evon
